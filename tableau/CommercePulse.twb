    <worksheet name='Review Score by Lateness Severity'>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders' name='federated.0zm3124055us221879qf414ea84j' />
          </datasources>
          <datasource-dependencies datasource='federated.0zm3124055us221879qf414ea84j'>
            <column caption='Lateness Severity' datatype='string' name='[Calculation_0177003484229635]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([delivery_vs_estimate_days]) THEN&#10;    &quot;Unknown&quot;&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 0 THEN&#10;    &quot;On time / early&quot;&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 3 THEN&#10;    &quot;1-3 days late&quot;&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 7 THEN&#10;    &quot;4-7 days late&quot;&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 14 THEN&#10;    &quot;8-14 days late&quot;&#10;ELSE&#10;    &quot;15+ days late&quot;&#10;END' />
            </column>
            <column caption='Lateness Severity Sort' datatype='integer' name='[Calculation_0177003484311556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([delivery_vs_estimate_days]) THEN 6&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 0 THEN 1&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 3 THEN 2&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 7 THEN 3&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 14 THEN 4&#10;ELSE 5&#10;END' />
            </column>
            <column caption='Average Review Score' datatype='real' name='[average_review_score]' role='measure' type='quantitative' />
            <column-instance column='[average_review_score]' derivation='Avg' name='[avg:average_review_score:qk]' pivot='key' type='quantitative' />
            <column caption='Delivery Vs Estimate Days' datatype='real' name='[delivery_vs_estimate_days]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0177003484311556]' derivation='Min' name='[min:Calculation_0177003484311556:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0177003484229635]' derivation='None' name='[none:Calculation_0177003484229635:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_status]' derivation='None' name='[none:order_status:nk]' pivot='key' type='nominal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0zm3124055us221879qf414ea84j].[none:Calculation_0177003484229635:nk]'>
