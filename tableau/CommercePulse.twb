      <aliases enabled='yes' />
      <column caption='Delivery Timing' datatype='string' name='[Calculation_0177003481866242]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [was_delivered_late] THEN&#10;    &quot;Late&quot;&#10;ELSE&#10;    &quot;On Time&quot;&#10;END' />
      </column>
      <column caption='Lateness Severity' datatype='string' name='[Calculation_0177003484229635]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([delivery_vs_estimate_days]) THEN&#10;    &quot;Unknown&quot;&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 0 THEN&#10;    &quot;On time / early&quot;&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 3 THEN&#10;    &quot;1-3 days late&quot;&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 7 THEN&#10;    &quot;4-7 days late&quot;&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 14 THEN&#10;    &quot;8-14 days late&quot;&#10;ELSE&#10;    &quot;15+ days late&quot;&#10;END' />
      </column>
      <column caption='Lateness Severity Sort' datatype='integer' name='[Calculation_0177003484311556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([delivery_vs_estimate_days]) THEN 6&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 0 THEN 1&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 3 THEN 2&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 7 THEN 3&#10;ELSEIF [delivery_vs_estimate_days] &lt;= 14 THEN 4&#10;ELSE 5&#10;END' />
      </column>
      <column caption='Delivered Orders per State' datatype='integer' name='[Calculation_0177003495419911]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_state (fact_orders.csv)] :&#10;    COUNTD(&#10;        IF [order_status] = &quot;delivered&quot;&#10;        THEN [order_id]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Delivered Order Count per Customer' datatype='integer' name='[Calculation_0177003496345608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_unique_id] :&#10;    COUNTD(&#10;        IF [order_status] = &quot;delivered&quot;&#10;        THEN [order_id]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Customer Order Segment' datatype='string' name='[Calculation_0177003496419337]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0177003496345608] = 1 THEN&#10;    &quot;1 order&quot;&#10;ELSEIF [Calculation_0177003496345608] &gt;= 2&#10;    AND [Calculation_0177003496345608] &lt;= 3 THEN&#10;    &quot;2-3 orders&quot;&#10;ELSEIF [Calculation_0177003496345608] &gt;= 4 THEN&#10;    &quot;4+ orders&quot;&#10;ELSE&#10;    &quot;No delivered orders&quot;&#10;END' />
      </column>
      <column caption='Late Delivery Flag' datatype='integer' name='[Calculation_1422406546817024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [was_delivered_late] THEN 1 ELSE 0 END' />
      </column>
